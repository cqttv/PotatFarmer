# Potat API Bearer Token
# Required
BEARER_TOKEN=

# Potat API execute endpoint url
# Optional, defaults to https://api.potat.app/execute
# API_URL=https://api.potat.app/execute

# PotatBotat Bot Prefix
# Optional, defaults to #
# BOT_PREFIX=#

# Web port that hosts web dasboard and API
# Optional, defaults to 3000
# WEB_PORT=3000

# Web Dashboard Enabled Boolean
# Optional, defaults to true
# WEB_DASHBOARD_ENABLED=true

# Console Stats Table Enabled Boolean
# Optional, defaults to true
# CONSOLE_STATS_ENABLED=true

# Structured log verbosity: debug, info, warn, or error
# Optional, defaults to debug. Use debug when investigating command/quiz flows.
# LOG_LEVEL=debug

# File where structured logs are retained
# Optional, defaults to logs/potatfarmer.log
# LOG_FILE=logs/potatfarmer.log

# Delay in ms between command executions
# Optional, defaults to 1000
# COMMAND_DELAY=1000

# Delay in ms between status checks
# Optional, defaults to 30000
# STATUS_INTERVAL=30000

# Automatically complete quizzes
# Optional, defaults to true; AI_API_KEY must also be set
# QUIZ_ENABLED=true

# AI provider used by the quiz solver
# Optional, defaults to openai; supported values: openai, gemini, deepseek
# API_PROVIDER=openai

# API key for the selected AI provider
# Required when QUIZ_ENABLED=true
AI_API_KEY=
